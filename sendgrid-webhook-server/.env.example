# Server
PORT=3001

# --- MongoDB (pick ONE style) ---

# Option A — Recommended for Atlas: host + user + password (plain text; no URL-encoding).
# Host only: copy from Atlas Connect string (e.g. cluster0.abcd.mongodb.net), no mongodb+srv prefix.
MONGODB_HOST=
MONGODB_USER=
MONGODB_PASSWORD=
# Optional query label shown in Atlas metrics
MONGODB_APP_NAME=sendgrid-webhook

# Option B — Full URI (password must be URL-encoded if it contains @ : / # etc.)
# DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

DATABASE_NAME=email_webhooks

# SendGrid “Signed Event Webhook” — paste Verification Key from Event Webhook settings (one long base64 line).
# When set, POST /sendgrid/events verifies X-Twilio-Email-Event-Webhook-Signature + Timestamp headers.
SENDGRID_VERIFICATION_KEY=

# Optional extra shared secret (?secret= or X-Webhook-Secret), only used if SENDGRID_VERIFICATION_KEY is empty.
WEBHOOK_SECRET=

# Max clock skew for signed webhooks (seconds). Default 600.
WEBHOOK_TS_TOLERANCE_SEC=600
