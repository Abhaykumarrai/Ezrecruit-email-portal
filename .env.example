SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=verified-sender@yourdomain.com
SENDGRID_FROM_NAME=Your Team
SENDGRID_REPLY_TO=replies@yourdomain.com
# Numeric id from SendGrid → Suppressions → Unsubscribe Groups.
# When set, each message uses that group's one-click unsubscribe. When empty, subscription tracking is used.
SENDGRID_ASM_GROUP_ID=
# Street address appended on every message. Required for CAN-SPAM.
SENDGRID_POSTAL_ADDRESS=
# Extra From domains that are authenticated in SendGrid, comma-separated.
SENDGRID_ALLOWED_FROM_DOMAINS=
# Click tracking stays off until link branding is valid for the From domain, unless this is true.
SENDGRID_LINK_BRANDING=
# Set to false to omit the open-tracking pixel.
SENDGRID_OPEN_TRACKING=true
